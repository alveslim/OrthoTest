# Supabase: use a chave pública (publishable/anon) no cliente e no backend.
# No celular não há .env: os mesmos valores públicos ficam em app/config_publica.json.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# API FastAPI
API_BASE_URL=http://127.0.0.1:8000/api/v1
# No Vercel, inclua o endereço da versão web do app (veja docs/publicacao.md).
CORS_ORIGINS=http://localhost:8550,http://127.0.0.1:8550
# true = demonstração: dados de exemplo em memória, login aceita qualquer coisa, nada é gravado.
# Não use em avaliações reais. (O modo sem internet de verdade é automático.)
MODO_DEMO=false

# Opcional: contato mostrado no termo de consentimento (ex.: Prof.ª Fulana, fulana@exemplo.edu.br)
TERMO_CONTATO=

# IA é opcional. Sem provedor configurado, a aplicação entrega um resumo
# estruturado determinístico a partir das regras clínicas locais.
LLM_API_URL=http://127.0.0.1:11434/api/generate
LLM_MODEL=gemma
NVIDIA_API_URL=
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-4-340b-instruct

# NÃO colocar service_role no cliente. O backend usa a sessão do usuário
# para que as políticas RLS do Supabase sejam aplicadas em cada requisição.
